<UserControl x:Class="UEVR.UnrealInjectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UEVR"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalAlignment="Stretch" x:Name="ContentScrollView" CanContentScroll="True" MaxHeight="1000">
        <StackPanel VerticalAlignment="Stretch" Orientation="Vertical">
            <GroupBox VerticalAlignment="Stretch" Header="URvr Injector">
                <StackPanel Orientation="Vertical">
                    <ComboBox x:Name="m_processListBox" DropDownOpened="ComboBox_DropDownOpened"
                            SelectionChanged="ComboBox_SelectionChanged" VerticalAlignment="Top" MinWidth="500" />
                    <Button x:Name="m_injectButton" Content="Inject" Click="Inject_Clicked" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                    x:Name="m_autoInject" />
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                    x:Name="m_nullifyVRPluginsCheckbox" />
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                    TextWrapping="Wrap" Text="Nullify VR Plugins" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="m_focusGameOnInjectionCheckbox" HorizontalAlignment="Left"
                                    IsChecked="True" />
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                    TextWrapping="Wrap" Text="Focus game on injection" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10,5,0,0" x:Name="m_injectAfterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                TextWrapping="Wrap" Text="Delay Inject After " VerticalAlignment="Center" />
                        <ComboBox x:Name="m_injectTime" DropDownOpened="ComboBox_DropDownOpened" VerticalAlignment="Top"
                                  Width="50">
                            <ComboBoxItem Foreground="White" Content="5" />
                            <ComboBoxItem Foreground="White" Content="10" IsSelected="True" />
                            <ComboBoxItem Foreground="White" Content="30" />
                            <ComboBoxItem Foreground="White" Content="60" />
                        </ComboBox>
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                TextWrapping="Wrap" Text=" seconds." VerticalAlignment="Center" />
                    </StackPanel>
               
                    <TextBlock x:Name="m_connectionStatus" Margin="0,7,0,5" TextWrapping="Wrap" Text="Unknown status"
                            Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </StackPanel>
            </GroupBox>
            <GroupBox VerticalAlignment="Stretch"  x:Name="m_GameCompatibiltySection" Header="Game UeVR Compatibility">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Vertical" VerticalAlignment="Center">
             
                        <StackPanel Margin="0,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="Playability:" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" x:Name="m_CompatibilityPlayability" Foreground="White"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="Rendering Method:"
                                    VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" x:Name="m_CompatibilityRenderingMethod" Foreground="White"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="1st" x:Name="m_Compatibility1st" Foreground="White"
                                    VerticalAlignment="Center" />
                            <CheckBox Margin="10,0,0,0" Content="3rd" x:Name="m_Compatibility3rd" Foreground="White"
                                    VerticalAlignment="Center" />
                            <CheckBox Margin="10,0,0,0" Content="3Dof" x:Name="m_Compatibility3Dof" Foreground="White"
                                    VerticalAlignment="Center" />
                            <CheckBox Margin="10,0,0,0" Content="6Dof" x:Name="m_Compatibility6Dof" Foreground="White"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1"  Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="Game View:" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" x:Name="m_CompatibilityGameView" Foreground="White"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="UE Version:" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" x:Name="m_CompatibilityUeVersion" Foreground="White"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="UE Major:" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" x:Name="m_CompatibilityUeMajor" Foreground="White"
                                    TextWrapping="Wrap" Text="Auto Inject" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox VerticalAlignment="Stretch" Name="m_GameSettings" Header="Game Settings">
                <ListView VerticalAlignment="Stretch" ScrollViewer.CanContentScroll="True" x:Name="m_iniListView">
                    <ListView.Resources>
                        <DataTemplate x:Key="ComboBoxTemplate">
                            <ComboBox ToolTip="{Binding Tooltip}" ItemsSource="{Binding ComboValues}"
                                    SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Value}"
                                    SelectionChanged="ComboChanged_Value" />
                        </DataTemplate>
                        <DataTemplate x:Key="TextBoxTemplate">
                            <TextBox ToolTip="{Binding Tooltip}" Text="{Binding Value, Mode=TwoWay}" Width="150"
                                    TextChanged="TextChanged_Value" />
                        </DataTemplate>
                        <DataTemplate x:Key="CheckBoxTemplate">
                            <CheckBox ToolTip="{Binding Tooltip}" IsChecked="{Binding ValueAsBool,Mode=TwoWay}"
                                    Width="150" Checked="CheckChanged_Value" Unchecked="CheckChanged_Value" />
                        </DataTemplate>
                        <DataTemplate x:Key="KeyTemplate">
                            <TextBlock ToolTip="{Binding Tooltip}" Text="{Binding Key}" />
                        </DataTemplate>
                        <local:ValueTemplateSelector x:Key="valueTemplateSelector"
                                ComboBoxTemplate="{StaticResource ComboBoxTemplate}"
                                TextBoxTemplate="{StaticResource TextBoxTemplate}"
                                CheckboxTemplate="{StaticResource CheckBoxTemplate}" />
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Key" Width="200" CellTemplate="{StaticResource KeyTemplate}" />
                            <GridViewColumn Header="Value" CellTemplateSelector="{StaticResource valueTemplateSelector}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
